{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/api/visit$",
      "dest": "/api/visit"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com|.+\\.store\\.jehre\\.com)"
        }
      ],
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
      },
      "continue": true
    },
    {
      "src": "^/(?!api/).+\\.(?:js|css)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com|.+\\.store\\.jehre\\.com)"
        }
      ],
      "headers": {
        "Cache-Control": "public, max-age=300"
      },
      "continue": true
    },
    {
      "src": "^/(?!api/).+\\.(?:webp|png|jpg|jpeg|svg|gif|ico|woff2|woff|mp4)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com|.+\\.store\\.jehre\\.com)"
        }
      ],
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "^/(admin|compte|studio|creer|abonnements)(/.*)?$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "Content-Security-Policy": "frame-ancestors 'self'",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/concepts/jeere/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(creer|admin|compte|abonnements|studio|b|mentions-legales|confidentialite)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "^/b/sitemap\\.xml$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "dest": "/api/sitemap"
    },
    {
      "src": "^/modeles/(anse|seve|soyeuse|michou|regard|vernie|minuit)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/modeles/$1/"
      }
    },
    {
      "src": "^/modeles/(anse|seve|soyeuse|michou|regard|vernie|minuit)/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "dest": "https://kreeative.xyz/concepts/$1/$2"
    },
    {
      "src": "^/b/([A-Za-z0-9-]+)((?:/(?:produits|pages)/[^/.?]+|/panier|/paiement)?)/?$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "dest": "/api/store?slug=$1&path=$2"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "dest": "/concepts/jeere/index.html"
    },
    {
      "src": "^/(.+/)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "dest": "/concepts/jeere/$1index.html"
    },
    {
      "src": "^/(.+)$",
      "has": [
        {
          "type": "host",
          "value": "(jeere\\.kreeative\\.xyz|jehre\\.com)"
        }
      ],
      "dest": "/concepts/jeere/$1"
    },
    {
      "src": "^/((?!concepts/jeere/)[^.]*)$",
      "missing": [
        {
          "type": "host",
          "value": "kreeative.xyz"
        },
        {
          "type": "host",
          "value": {
            "suf": ".kreeative.xyz"
          }
        },
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        },
        {
          "type": "host",
          "value": "localhost"
        }
      ],
      "dest": "/api/store?path=/$1"
    }
  ],
  "functions": {
    "api/store.js": {
      "includeFiles": "concepts/jeere/{b/index.html,creer/data.js,creer/render.js}",
      "maxDuration": 10
    }
  }
}
